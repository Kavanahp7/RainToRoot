# ==========================================
# RainToRoot - Backend Environment Settings (.env.example)
# ==========================================
# Copy this file to backend/.env and replace placeholders with your actual values:
#   cp .env.example backend/.env
#
# DO NOT commit backend/.env to Git or expose your production keys publicly.

# --- 1. Flask Application Security ---
# A strong random secret key for session signing and cryptographic components.
# Generate one locally via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-min-32-chars

# --- 2. CORS Configuration (Allowed Frontend Origins) ---
# Comma-separated list of allowed origins.
# Local development:
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Production on Render / Vercel:
# FRONTEND_ORIGIN=https://your-frontend-app.onrender.com

# Server Port and Debug mode (Render dynamically assigns PORT in production)
FLASK_ENV=development
PORT=5000
FLASK_DEBUG=False
# In production, use explicit HTTPS origins plus secure cross-site session cookies.
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax

# --- 3. Google Gemini AI Assistant ---
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Verified default as of November 2026. You may override it with a model available to your API key.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- 4. MySQL Database Credentials ---
# Configure your local or cloud MySQL database instance.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=raintoroot

# --- 5. Market Data Provider (Conditional) ---
# NOTE: The current RainToRoot Mandi module is a price trend calculator based on
# verified prices entered by the farmer and does NOT require an external API key.
# If you integrate live Agmarknet / Government of India market data in the future,
# register at https://data.gov.in and configure:
# DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
# DATA_GOV_IN_RESOURCE_ID=the_resource_id_shown_in_the_data_gov_in_catalog_api

# --- 6. SMTP Email Configuration (Password Reset) ---
# Required for sending time-limited password reset links.
# For Gmail, use smtp.gmail.com, port 587, and a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_email@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=RainToRoot <your_sender_email@example.com>
SMTP_USE_TLS=True
# Optional explicit frontend URL for password reset links (defaults to first FRONTEND_ORIGIN):
# FRONTEND_APP_URL=https://your-frontend-app.onrender.com
