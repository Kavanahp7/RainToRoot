# ==========================================
# RainToRoot - Git Ignore Configuration
# ==========================================

# Environment and Secret Credential Files
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local

# Allow example environment templates
!.env.example
!backend/.env.example
!frontend/.env.example

# Python & Virtual Environments
venv/
venv312/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
pyvenv.cfg
.pytest_cache/
.coverage

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE, OS & System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
*.log
