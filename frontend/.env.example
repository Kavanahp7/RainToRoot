# ==========================================
# RainToRoot - Frontend Environment Settings (.env.example)
# ==========================================
# Copy this file to frontend/.env.local or frontend/.env:
#   cp frontend/.env.example frontend/.env.local

# Backend API base URL for local development:
VITE_API_URL=http://127.0.0.1:5000

# When deployed (e.g., Render / Vercel), set to your hosted backend Web Service URL:
# VITE_API_URL=https://raintoroot-backend.onrender.com
